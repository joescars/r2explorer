R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: Cloudflare API token, used to list buckets if the S3 token can't
CLOUDFLARE_API_TOKEN=
# Optional: comma-separated bucket allowlist (leave empty to show all)
R2_BUCKETS=
APP_PASSWORD=
# 32+ random chars (openssl rand -hex 32)
SESSION_SECRET=
READ_ONLY=false
# Avoid 6665-6669 (blocked by browsers)
PORT=3000
